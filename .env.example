# MinerU MCP Service — environment variables
# Copy to .env and adjust for your environment

# --- MCP Server ---
MCP_HOST=0.0.0.0
MCP_PORT=8765

# --- MinerU API (mineru-api, started from MinerU official repo) ---
MINERU_API_URL=http://localhost:8000

# --- Parse options ---
# Backend: vlm-http-client (recommended), pipeline, vlm-auto-engine
MINERU_BACKEND=vlm-http-client

# OpenAI-compatible VLM server URL (mineru-openai-server, port 30000)
# NOTE: This is the vLLM gateway, NOT the mineru-api on port 8000
MINERU_VLM_HTTP_URL=http://localhost:30000

# Document language
MINERU_LANG=ch

# Per-document timeout in seconds
MINERU_TIMEOUT_SEC=1800

# --- Work dir for uploaded files ---
MINERU_WORK_DIR=/root/autodl-tmp/mineru_mcp
