# MinerU MCP Service — environment variables
# Copy to .env and adjust for your environment

# --- Server ---
MCP_HOST=0.0.0.0
MCP_PORT=8765

# --- MinerU CLI ---
# Path to mineru executable. Leave empty to auto-detect from current Python environment.
MINERU_CMD=

# Backend mode: vlm-http-client (recommended), pipeline, vlm-auto-engine
MINERU_BACKEND=vlm-http-client

# OpenAI-compatible VLM server URL (mineru --url / -u)
# For MinerU 2.7: this is the mineru-openai-server on port 30000, NOT the mineru-api on 8000
MINERU_VLM_HTTP_URL=http://localhost:30000

# Parse method: auto, txt, ocr
MINERU_METHOD=auto

# Document language
MINERU_LANG=ch

# Per-document timeout in seconds (large PDFs can take several minutes)
MINERU_TIMEOUT_SEC=1800

# Working directory for temp files (must be writable)
MINERU_WORK_DIR=/tmp/mineru_mcp
